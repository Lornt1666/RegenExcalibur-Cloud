{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "1jgm://governed-gateway/task-contract/v1.0",
  "title": "1JGM Governed Gateway Task Contract v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","task_id","idempotency_key","initiated_by","session_ref","aigc_contract_ref","target","operation","arguments","resource_scope","risk_level","approval_id","expires_at","execution","expected_outputs","acceptance_criteria","state","audit_correlation_id"],
  "properties": {
    "contract_version": {"const": "1JGM-GATEWAY-TASK-1.0"},
    "task_id": {"type":"string","minLength":1},
    "idempotency_key": {"type":"string","minLength":1},
    "initiated_by": {"type":"string","minLength":1},
    "session_ref": {"type":"string","minLength":1},
    "aigc_contract_ref": {"type":"string","minLength":1,"description":"Reference to an independently validated existing AIGC TaskContract; not a replacement for it."},
    "target": {
      "type":"object","additionalProperties":false,"required":["kind"],
      "properties": {
        "kind":{"enum":["repository","project","cloud_shell","antigravity","job_platform"]},
        "repository":{"type":"string","minLength":1},
        "branch":{"type":"string","minLength":1},
        "project_id":{"type":"string","minLength":1},
        "environment":{"type":"string","minLength":1},
        "workspace_id":{"type":"string","minLength":1}
      }
    },
    "operation":{"enum":["repo.read_file","repo.list_tree","aigc.run_phase","job.search","job.prepare_application","job.submit_application","google.cloud_shell.read_only_diagnostic","google.antigravity.prepare_handoff"]},
    "arguments":{"type":"object","description":"Further restricted by operation-specific server-side allowlists in task_contract.py."},
    "resource_scope":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "risk_level":{"enum":["low","medium","high","critical"]},
    "approval_id":{"type":["string","null"],"description":"Opaque server-side approval record reference; never an approval assertion by itself."},
    "expires_at":{"type":"string","format":"date-time"},
    "execution":{
      "type":"object","additionalProperties":false,"required":["timeout_seconds","max_output_bytes"],
      "properties":{"timeout_seconds":{"type":"integer","minimum":1,"maximum":900},"max_output_bytes":{"type":"integer","minimum":1,"maximum":2000000}}
    },
    "expected_outputs":{"type":"array","items":{"type":"string"}},
    "acceptance_criteria":{"type":"array","items":{"type":"string"}},
    "state":{"enum":["REQUESTED","AUTHORIZED","REJECTED","BLOCKED","CANCELLED"]},
    "audit_correlation_id":{"type":"string","minLength":1}
  }
}
